# https://git-scm.com/docs/gitattributes
# 本项目主战场是 Windows，但 CI / 贡献者的环境各不相同，必须显式声明换行策略。

# 默认：交给 Git 判断是不是文本文件
* text=auto

# C# / XAML / 项目文件：Windows 生态，CRLF
*.cs        text eol=crlf
*.xaml      text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.config    text eol=crlf

# NSIS 与 Windows 脚本：CRLF
*.nsi       text eol=crlf
*.nsh       text eol=crlf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# CI 配置与类 Unix 脚本：LF（YAML 与 shell 对 CRLF 敏感）
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.py        text eol=lf

# 二进制资源：永不转换
*.png       binary
*.jpg       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.exe       binary
*.dll       binary
*.zip       binary
*.7z        binary
