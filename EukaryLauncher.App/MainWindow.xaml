<Window x:Class="EukaryLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
        xmlns:views="clr-namespace:EukaryLauncher.App.Views"
        xmlns:svc="clr-namespace:EukaryLauncher.App.Services"
        xmlns:controls="clr-namespace:EukaryLauncher.App.Controls"
        xmlns:anim="clr-namespace:EukaryLauncher.App.Animation"
        mc:Ignorable="d"
        Title="真核启动器"
        MinWidth="900" MinHeight="600"
        Width="1040" Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBaseBrush}"
        FontFamily="{StaticResource FontSans}">

    <!-- 去掉 Windows 传统边框，自绘标题栏 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 关闭按钮：hover 变红 -->
        <Style x:Key="CloseChromeButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toast：左下角堆叠，左侧竖条按类型着色。
             注意不能加 BitmapEffect（如 DropShadowEffect）——切页重绘时带效果的区域
             会被渲染线程跳过，Toast 会“消失”但视觉树一切正常（脏区域 bug，2026-11-06 实测） -->
        <DataTemplate DataType="{x:Type svc:ToastItem}">
            <Border Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}" Padding="0" Margin="0,8,0,0"
                    MinWidth="260" MaxWidth="400" SnapsToDevicePixels="True">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Margin="0">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource InfoBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeSm}"
                               Foreground="{DynamicResource Text1Brush}"
                               Margin="12,10"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsoleViewModel}">
            <views:ConsoleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>
    </Window.Resources>

    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/Assets/AppIcon.png"/>
    </Window.Icon>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== 自绘标题栏 ===================== -->
            <Grid Grid.Row="0" Background="{DynamicResource BgElevatedBrush}">
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"/>

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <!-- Logo：真核细胞意象（外膜 + 核仁），自绘，不使用任何 Minecraft 素材 -->
                    <Grid Width="16" Height="16" Margin="0,0,10,0">
                        <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"/>
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <TextBlock Text="真核启动器" FontSize="{StaticResource FontSizeSm}"
                               Foreground="{DynamicResource Text1Brush}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource GhostButton}"
                            Width="46" Height="30" Padding="0" MinWidth="0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最小化" Click="OnMinimizeClick">
                        <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" StrokeStartLineCap="Round"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource GhostButton}"
                            Width="46" Height="30" Padding="0" MinWidth="0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="最大化" Click="OnMaximizeClick">
                        <Rectangle Width="10" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.2" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseChromeButton}"
                            Width="46" Height="30" Padding="0" MinWidth="0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="关闭" Click="OnCloseClick">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" StrokeStartLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== 主体 ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border Grid.Column="0" x:Name="MainSidebar" Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="MainSidebarTf"/>
                    </Border.RenderTransform>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
                                 SelectedValuePath="Page"
                                 ItemContainerStyle="{StaticResource SidebarItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeSm}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1" Margin="12,0,0,4"
                                   Text="EKL v0.2.0 · M2"
                                   Style="{StaticResource TextCaption}"/>
                    </Grid>
                </Border>

                <!-- 页面：一条竖直轨道，5 个页面按侧栏顺序自上而下排列。
                     切换时整条轨道上下滚动（跨度大就滚得快，总时长不变），
                     中途会真的经过中间页面。
                     注意：本机渲染线程对 TranslateTransform 平移的大元素不重绘
                     （脏区域 bug），滚动呈现必须走 ScrollViewer 路径。
                     PageHost 是视口，顺便承担版本选择页的位移/淡化。 -->
                <Border Grid.Column="1" x:Name="PageHost" ClipToBounds="True" Focusable="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PageHostTf"/>
                    </Border.RenderTransform>
                    <!-- PageScrollViewer：轨道自身不吃滚轮，内部列表照常滚 -->
                    <controls:PageScrollViewer x:Name="PageScroller" Focusable="False"
                                               VerticalScrollBarVisibility="Hidden"
                                               HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PageRail" VerticalAlignment="Top">
                            <ContentControl Content="{Binding Home}" Focusable="False"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Height="{Binding ActualHeight, ElementName=PageHost}"/>
                            <ContentControl Content="{Binding Download}" Focusable="False"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Height="{Binding ActualHeight, ElementName=PageHost}"/>
                            <ContentControl Content="{Binding Console}" Focusable="False"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Height="{Binding ActualHeight, ElementName=PageHost}"/>
                            <ContentControl Content="{Binding Settings}" Focusable="False"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Height="{Binding ActualHeight, ElementName=PageHost}"/>
                            <ContentControl Content="{Binding About}" Focusable="False"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Height="{Binding ActualHeight, ElementName=PageHost}"/>
                        </StackPanel>
                    </controls:PageScrollViewer>
                </Border>
            </Grid>

            <!-- ===================== 版本选择覆盖层 =====================
                 全窗覆盖（标题栏以下），进出动画由 MainWindow 编排：
                 主侧栏左出 / 主页按钮右出 / 新侧栏左入 / 版本列表右入 -->
            <Grid x:Name="VersionSelectOverlay" Grid.Row="1"
                  Background="{DynamicResource BgBaseBrush}" Visibility="Collapsed">
                <views:VersionSelectView x:Name="VersionSelectView"
                                         DataContext="{Binding VersionSelect}"/>
            </Grid>

            <!-- ===================== 通用模态确认弹窗 ===================== -->
            <Grid x:Name="ConfirmHost" Grid.Row="0" Grid.RowSpan="2"
                  Background="{StaticResource ScrimBrush}" Visibility="Collapsed">
                <Border Background="{StaticResource BgElevatedBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="24"
                        Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <TextBlock x:Name="ConfirmTitle" FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text1Brush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ConfirmMessage" Style="{StaticResource TextBody}"
                                   Foreground="{StaticResource Text2Brush}" Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="取消" Style="{StaticResource SecondaryButton}"
                                    Click="OnConfirmCancelClick"/>
                            <Button x:Name="ConfirmActionButton" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" MinWidth="96"
                                    Click="OnConfirmActionClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 通知浮层：不拦截鼠标事件，避免挡住下面的操作。
                 注意 Source 是 ToastService，集合要再往下走一层 .Toasts -->
            <ItemsControl x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="2"
                          ItemsSource="{Binding Toasts, Source={x:Static svc:AppServices.Toasts}}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,20,20" IsHitTestVisible="False"
                          Focusable="False"/>

            <!-- ===================== 模态弹窗遮罩 ===================== -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  Background="{StaticResource ScrimBrush}"
                  Visibility="{Binding Settings.IsJvmDialogOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="{StaticResource DurationPage}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="{StaticResource BgElevatedBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="24"
                        Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="24" ShadowDepth="4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="额外 JVM 参数" FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Text1Brush}"/>
                        <TextBlock Text="多个参数用空格分隔；含空格的路径要用引号包起来。"
                                   Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>

                        <TextBox Text="{Binding Settings.JvmDialogText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,16,0,0"
                                 ToolTip="例如 -XX:+UseG1GC，多个参数用空格分隔，含空格的路径用引号包裹">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Settings.ConfirmJvmDialogCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="放弃更改" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Settings.CancelJvmDialogCommand}"/>
                            <Button Content="确认更改" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding Settings.ConfirmJvmDialogCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
