<UserControl x:Class="EukaryLauncher.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             FontFamily="{StaticResource FontSans}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Grid Width="44" Height="44" Margin="0,0,16,0">
                        <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.4"/>
                        <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="真核启动器 Eukary Launcher" FontSize="{StaticResource FontSizeXl}"
                                   FontWeight="Bold" Foreground="{DynamicResource Text1Brush}"/>
                        <TextBlock Text="EKL · 免费，开源，个性化"
                                   Style="{StaticResource TextCaption}"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="版本" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Version}" Style="{StaticResource TextBody}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="开发者" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding Author}" Style="{StaticResource TextBody}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="开源协议" Style="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding License}" Style="{StaticResource TextBody}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 合规声明：这是必须放在显眼位置的免责条款 -->
                <Border Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="免责声明" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SourceNote}" Style="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="资源来源" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                                   Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource TextMuted}">
                            <Run Text="· 版本清单与游戏文件：Mojang 官方 / BMCLAPI 镜像"/>
                            <LineBreak/>
                            <Run Text="· Java 运行时：Eclipse Temurin（Adoptium）"/>
                            <LineBreak/>
                            <Run Text="· 本启动器不打包、不分发任何 Minecraft 游戏文件"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="BMCLAPI" Style="{StaticResource SmallButton}"
                                    Command="{Binding OpenLinkCommand}"
                                    CommandParameter="https://bmclapidoc.bangbang93.com/"/>
                            <Button Content="Adoptium" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenLinkCommand}"
                                    CommandParameter="https://adoptium.net/"/>
                            <Button Content="GPL-3.0" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenLinkCommand}"
                                    CommandParameter="https://www.gnu.org/licenses/gpl-3.0.html"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
