<UserControl x:Class="EukaryLauncher.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             FontFamily="{StaticResource FontSans}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <!-- 应用概览 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                    <Grid Width="52" Height="52" Margin="0,0,16,0">
                        <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.4"/>
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="真核启动器 Eukary Launcher" FontSize="{StaticResource FontSizeXl}"
                                   FontWeight="Bold" Foreground="{DynamicResource Text1Brush}"/>
                        <TextBlock Text="EKL · 免费，开源，个性化"
                                   Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ============================ 应用信息 ============================ -->
                <TextBlock Text="应用信息" Style="{StaticResource SettingsSectionTitle}"/>
                <Border Style="{StaticResource SettingsGroup}" Margin="0,0,0,24">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource SettingsValue}"/>
                            </Grid>
                        </ContentControl>
                        <ContentControl Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开发者" Style="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Author}" Style="{StaticResource SettingsValue}"/>
                            </Grid>
                        </ContentControl>
                        <ContentControl Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开源协议" Style="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding License}" Style="{StaticResource SettingsValue}"/>
                            </Grid>
                        </ContentControl>
                        <ContentControl Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="运行环境" Style="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding RuntimeText}" Style="{StaticResource SettingsValue}"/>
                            </Grid>
                        </ContentControl>
                        <ContentControl Style="{StaticResource SettingsRowLast}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="数据目录" Style="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource MonoText}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="80"
                                        Command="{Binding OpenDataFolderCommand}"/>
                            </Grid>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <!-- ============================ 项目 ============================ -->
                <TextBlock Text="项目" Style="{StaticResource SettingsSectionTitle}"/>
                <Border Style="{StaticResource SettingsGroup}" Margin="0,0,0,24">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SettingsRowLast}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="源码仓库" Style="{StaticResource TextBody}"/>
                                    <TextBlock Text="{Binding Repository}" Style="{StaticResource MonoText}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="复制" Style="{StaticResource SecondaryButton}" Width="80"
                                            Command="{Binding CopyRepositoryCommand}"/>
                                    <Button Content="访问" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding OpenLinkCommand}"
                                            CommandParameter="{Binding RepositoryLink}"/>
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </StackPanel>
                </Border>

                <!-- ============================ 免责声明 ============================ -->
                <TextBlock Text="合规" Style="{StaticResource SettingsSectionTitle}"/>
                <Border Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="免责声明" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SourceNote}" Style="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ============================ 资源来源 ============================ -->
                <TextBlock Text="资源来源" Style="{StaticResource SettingsSectionTitle}"/>
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="版本清单与游戏文件" Style="{StaticResource TextBody}"/>
                                    <TextBlock Text="Mojang 官方 / BMCLAPI 镜像" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="访问" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="80"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding BmclapiLink}"/>
                            </Grid>
                        </ContentControl>
                        <ContentControl Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="Java 运行时" Style="{StaticResource TextBody}"/>
                                    <TextBlock Text="Eclipse Temurin（Adoptium）" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="访问" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="80"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding AdoptiumLink}"/>
                            </Grid>
                        </ContentControl>
                        <ContentControl Style="{StaticResource SettingsRowLast}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="开源协议" Style="{StaticResource TextBody}"/>
                                    <TextBlock Text="GNU General Public License v3.0" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="访问" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Width="80"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding LicenseLink}"/>
                            </Grid>
                        </ContentControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
