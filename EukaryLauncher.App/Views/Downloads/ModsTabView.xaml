<UserControl x:Class="EukaryLauncher.App.Views.Downloads.ModsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModsTabViewModel}"
             FontFamily="{StaticResource FontSans}">
    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 筛选：两行。第一行 名称 + 搜索按钮，第二行 版本 / 加载器 / 来源 -->
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称或关键词搜索" Height="{StaticResource ControlHeightMd}"
                             VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索" Style="{StaticResource PrimaryButton}"
                            Height="34" Padding="20,0" FontSize="{StaticResource FontSizeSm}"
                            HorizontalAlignment="Right" MinWidth="84"
                            Command="{Binding SearchCommand}"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="版本" Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ListBox ItemsSource="{Binding GameVersions}"
                                 SelectedIndex="{Binding SelectedGameVersionIndex, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ChipItem}"
                                 Background="Transparent" BorderThickness="0" MaxWidth="330"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="加载器" Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ListBox ItemsSource="{Binding LoaderList}"
                                 SelectedIndex="{Binding SelectedLoaderIndex, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ChipItem}"
                                 Background="Transparent" BorderThickness="0" MaxWidth="360"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="来源" Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  Width="120" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 结果 -->
        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Results}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}" Padding="14"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 图标 -->
                                    <Border Grid.Column="0" Width="48" Height="48" Margin="0,0,14,0"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Background="{DynamicResource BgElevatedBrush}"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeBase}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}"/>
                                            <TextBlock Text="{Binding LoadersText}" Style="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource TextMuted}"
                                                   Margin="0,4,0,0" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding InstalledText}" Style="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0"
                                                   Visibility="{Binding InstalledText, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2" Content="加载更多" Style="{StaticResource GhostButton}"
                        Height="30" Margin="0,10,0,0"
                        Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding LoadMoreCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
