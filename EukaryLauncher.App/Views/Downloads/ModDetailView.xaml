<UserControl x:Class="EukaryLauncher.App.Views.Downloads.ModDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModDetailViewModel}"
             FontFamily="{StaticResource FontSans}">
    <UserControl.Resources>
        <!-- 发布通道徽标：R 正式 / B 测试 / A 内部 -->
        <Style x:Key="ReleaseBadge" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeLetter}" Value="R">
                    <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeLetter}" Value="B">
                    <Setter Property="Background" Value="{StaticResource DangerTintBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 头部：返回 + 模组信息 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="← 返回" Style="{StaticResource GhostButton}"
                    Height="28" Padding="10,0" MinWidth="0" FontSize="{StaticResource FontSizeXs}"
                    HorizontalAlignment="Left" Command="{Binding BackCommand}"/>

            <Grid Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                               Foreground="{DynamicResource Text1Brush}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource TextMuted}"
                               Margin="0,6,0,0" MaxWidth="620" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Content="在 Modrinth 打开" Style="{StaticResource SmallButton}"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Command="{Binding OpenProjectPageCommand}"/>
            </Grid>

            <!-- 游戏版本筛选条 -->
            <ListBox ItemsSource="{Binding VersionChips}"
                     SelectedIndex="{Binding SelectedVersionIndex, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ChipItem}"
                     Background="Transparent" BorderThickness="0" Margin="0,14,0,0"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 版本分组 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModVersionGroup}">
                        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 分组标题：点一下展开/收起 -->
                                <Button Style="{StaticResource GhostButton}" Padding="14,10" MinWidth="0"
                                        HorizontalContentAlignment="Stretch" Height="Auto"
                                        Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeSm}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}"/>
                                            <TextBlock Style="{StaticResource TextCaption}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Run Text="共 "/>
                                                <Run Text="{Binding Rows.Count, Mode=OneWay}"/>
                                                <Run Text=" 个文件"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                    <Setter Property="Text" Value="展开"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="收起"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>

                                <!-- 文件行 -->
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="8,0,8,8">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Padding="10,8" MinWidth="0"
                                                    Height="Auto" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Style="{StaticResource ReleaseBadge}"
                                                            Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeLetter}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Text1Brush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="{StaticResource FontSizeSm}"
                                                                   Foreground="{DynamicResource Text1Brush}"/>
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Style="{StaticResource TextCaption}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding DownloadsText}"
                                                                   Style="{StaticResource TextCaption}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PublishedText}"
                                                                   Style="{StaticResource TextCaption}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="14,0,0,0" MinWidth="60"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
