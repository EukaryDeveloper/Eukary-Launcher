<UserControl x:Class="EukaryLauncher.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             xmlns:views="clr-namespace:EukaryLauncher.App.Views.Downloads"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DownloadsViewModel}"
             FontFamily="{StaticResource FontSans}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:VanillaTabViewModel}">
            <views:VanillaTabView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoaderSelectViewModel}">
            <views:LoaderSelectView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsTabViewModel}">
            <views:ModsTabView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModDetailViewModel}">
            <views:ModDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueTabViewModel}">
            <views:QueueTabView/>
        </DataTemplate>

        <!-- 尚未实现的 Tab：统一的占位页 -->
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <!-- 真核细胞意象的灰化版，跟启动器 logo 呼应 -->
                <Grid Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,18" Opacity="0.45">
                    <Ellipse Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="2"/>
                    <Ellipse Width="13" Height="13" Fill="{DynamicResource BorderStrongBrush}"/>
                </Grid>
                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeLg}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Text}" Style="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Tabs：绿色下划线是一根共享滑条，切换时从旧 tab 滑到新 tab；
             文字颜色的渐变在 TabItem 模板里做（Controls.xaml） -->
        <Border Grid.Row="0" Background="{DynamicResource BgBaseBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="TabBar" Margin="24,4,24,0">
                <ListBox x:Name="TabList"
                         ItemsSource="{Binding Tabs}"
                         SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource TabItem}"
                         Background="Transparent" BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeSm}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 下划线滑条：位置/宽度由代码后置按选中项实测，margin -1 盖住分隔线 -->
                <Border x:Name="TabUnderline" Height="2"
                        Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="0,0,0,-1" IsHitTestVisible="False" Width="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TabUnderlineTf"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <!-- Tab 内容两层交叉过渡：新页滑入淡入、旧页反向滑出淡出。
             两层轮流当「前台」，视图实例一直留在某一层里，切回来不用重建 -->
        <Grid x:Name="TabContent" Grid.Row="1" ClipToBounds="True">
            <ContentControl x:Name="TabLayerUnder" Focusable="False" Visibility="Collapsed">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="TabLayerUnderTf"/>
                </ContentControl.RenderTransform>
            </ContentControl>
            <ContentControl x:Name="TabLayerOver" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="TabLayerOverTf"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
