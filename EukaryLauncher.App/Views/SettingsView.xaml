<UserControl x:Class="EukaryLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             FontFamily="{StaticResource FontSans}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <TextBlock Text="设置" FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                           Foreground="{DynamicResource Text1Brush}" Margin="0,0,0,24"/>

                <!-- 游戏目录 -->
                <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="游戏目录" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text=".minecraft 根目录，版本、资源、存档都在这里。修改后需要重新扫描已安装版本。"
                                   Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Grid>
                            <TextBox Text="{Binding GameDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" Margin="0,0,12,0"/>
                            <Button Content="浏览" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" Width="80"
                                    Command="{Binding BrowseGameDirectoryCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 下载源 -->
                <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="下载源" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="国内网络建议用 BMCLAPI，卡顿或失败时可切回官方源兜底。"
                                   Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding Mirrors}"
                                  SelectedValue="{Binding MirrorId, Mode=TwoWay}"
                                  SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Stretch"/>

                        <TextBlock Text="下载线程数" Style="{StaticResource TextMuted}" Margin="0,20,0,6"/>
                        <TextBox Text="{Binding DownloadThreads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120" HorizontalAlignment="Left" ToolTip="1–32，线程太多容易被镜像限流"/>
                    </StackPanel>
                </Border>

                <!-- Java -->
                <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Java 运行时" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding JavaStatusText}" Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <CheckBox Content="自动管理 Java（缺哪个版本就自动下载 JRE）"
                                  IsChecked="{Binding AutoManageJava, Mode=TwoWay}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <TextBox Text="{Binding CustomJavaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" Margin="0,0,12,0"
                                     ToolTip="不勾选自动管理时，用这里指定的 java.exe"/>
                            <Button Content="浏览" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" Width="80"
                                    Command="{Binding BrowseJavaCommand}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="下载 Java 21" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding DownloadJavaCommand}"
                                    IsEnabled="{Binding IsDownloadingJava, Converter={StaticResource InverseBool}}"/>
                            <Button Content="打开 runtime 目录" Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Command="{Binding OpenRuntimeFolderCommand}"/>
                        </StackPanel>

                        <ProgressBar Value="{Binding JavaProgressValue, Mode=OneWay}" Maximum="100"
                                     Margin="0,12,0,0"
                                     Visibility="{Binding IsDownloadingJava, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- 启动参数 -->
                <Border Style="{StaticResource Panel}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="启动参数" FontWeight="SemiBold" Style="{StaticResource TextBody}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="最大内存" Style="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding MemoryOptions}"
                                  SelectedItem="{Binding MaxMemoryMb, Mode=TwoWay}"
                                  Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <CheckBox Content="自定义游戏窗口尺寸" Margin="0,0,0,12"
                                  IsChecked="{Binding UseCustomResolution, Mode=TwoWay}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBox Text="{Binding WindowWidth, Mode=TwoWay}" Width="100"
                                     IsEnabled="{Binding UseCustomResolution}"/>
                            <TextBlock Text="×" Style="{StaticResource TextMuted}" Margin="10,0"
                                       VerticalAlignment="Center"/>
                            <TextBox Text="{Binding WindowHeight, Mode=TwoWay}" Width="100"
                                     IsEnabled="{Binding UseCustomResolution}"/>
                        </StackPanel>

                        <TextBlock Text="额外 JVM 参数" Style="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ExtraJvmArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch"
                                 ToolTip="例如 -XX:+UseG1GC，多个参数用空格分隔，含空格的路径用引号包裹"/>

                        <CheckBox Content="游戏启动后保持启动器运行" Margin="0,16,0,0"
                                  IsChecked="{Binding KeepLauncherOpen, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
