<UserControl x:Class="EukaryLauncher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             FontFamily="{StaticResource FontSans}">
    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：纵向 版本设置 / 版本选择（与开始游戏底边对齐） -->
        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
            <Button Content="版本设置" Style="{StaticResource SecondaryButton}"
                    Height="48" MinWidth="200"
                    ToolTip="为当前选择的版本单独设置内存、窗口和 JVM 参数"
                    Command="{Binding OpenVersionSettingsCommand}"/>
            <Button x:Name="VersionSelectButton" Content="版本选择" Style="{StaticResource SecondaryButton}"
                    Height="48" MinWidth="200" Margin="0,12,0,0"
                    ToolTip="选择要启动的已安装版本"
                    Click="OnVersionSelectClick"/>
        </StackPanel>

        <!-- 右下：开始游戏 -->
        <Button Grid.Column="1" Content="开始游戏" Style="{StaticResource LargeButton}"
                Height="48" MinWidth="220" FontSize="{StaticResource FontSizeLg}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Command="{Binding LaunchCommand}"
                IsEnabled="{Binding CanLaunch}"/>

        <!-- 版本选择弹层 -->
        <Popup x:Name="VersionSelectPopup"
               PlacementTarget="{Binding ElementName=VersionSelectButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource BgElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}" Margin="0,4,0,0"
                    Width="240" MaxHeight="420" Padding="4">
                <ListBox x:Name="VersionList"
                         ItemsSource="{Binding InstalledVersions}"
                         SelectedItem="{Binding SelectedVersionId, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnVersionListSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource BgHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource BgHoverBrush}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
