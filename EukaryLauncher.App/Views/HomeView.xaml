<UserControl x:Class="EukaryLauncher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             FontFamily="{StaticResource FontSans}">
    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 右下：开始游戏 + 上方并排两个幽灵按钮 -->
        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="版本设置" Style="{StaticResource GhostButton}"
                        Width="105" Height="32" FontWeight="Normal"
                        ToolTip="为当前选择的版本单独设置内存、窗口和 JVM 参数"
                        Command="{Binding OpenVersionSettingsCommand}"/>
                <Button x:Name="VersionSelectButton" Content="版本选择" Style="{StaticResource GhostButton}"
                        Width="105" Height="32" FontWeight="Normal" Margin="10,0,0,0"
                        ToolTip="选择要启动的已安装版本"
                        Click="OnVersionSelectClick"/>
            </StackPanel>
            <Button Content="开始游戏" Style="{StaticResource LargeButton}"
                    Height="48" MinWidth="220" FontSize="{StaticResource FontSizeLg}" Margin="0,12,0,0"
                    Command="{Binding LaunchCommand}"
                    IsEnabled="{Binding CanLaunch}"/>
        </StackPanel>

    </Grid>
</UserControl>
