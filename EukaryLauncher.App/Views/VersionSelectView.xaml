<UserControl x:Class="EukaryLauncher.App.Views.VersionSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EukaryLauncher.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VersionSelectViewModel}"
             FontFamily="{StaticResource FontSans}">

    <!-- 两列：新侧边栏（从左滑入） + 信息流（从右滑入） -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 新侧边栏 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource BgElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarTf"/>
            </Border.RenderTransform>

            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：返回按钮 + 居中标题 -->
                <Grid Grid.Row="0" Margin="2,4,2,10">
                    <Button x:Name="BackButton" Style="{StaticResource GhostButton}"
                            Width="32" Height="32" Padding="0" MinWidth="0"
                            HorizontalAlignment="Left"
                            ToolTip="返回主页" Command="{Binding BackCommand}">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="版本选择" FontSize="{StaticResource FontSizeBase}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Text1Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 中部：文件夹列表 + 导入或导出 -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="文件夹列表" Style="{StaticResource TextCaption}" Margin="4,8,0,6"/>
                    <ListBox ItemsSource="{Binding Folders}"
                             SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource Text1Brush}"/>
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent"
                                                    CornerRadius="{StaticResource RadiusSm}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource BgHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource BgHoverBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="导入或导出" Style="{StaticResource TextCaption}" Margin="4,20,0,6"/>
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                            Padding="10,7" HorizontalAlignment="Stretch" Height="Auto"
                            Command="{Binding ImportOrExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="导入或导出配置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 右侧信息流 ============ -->
        <Border Grid.Column="1" Background="{DynamicResource BgBaseBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ContentTf"/>
            </Border.RenderTransform>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="28,24">
                    <TextBlock Text="{Binding SelectedFolder.DisplayName}"
                               FontSize="{StaticResource FontSizeXl}" FontWeight="Bold"
                               Foreground="{DynamicResource Text1Brush}"/>
                    <TextBlock Text="{Binding FolderPath}" Style="{StaticResource TextCaption}"
                               Margin="0,6,0,24" TextTrimming="CharacterEllipsis"/>

                    <!-- ============ 文件夹设置 ============ -->
                    <TextBlock Text="文件夹设置" Style="{StaticResource SettingsSectionTitle}"/>
                    <Border Style="{StaticResource SettingsGroup}" Margin="0,0,0,24">
                        <StackPanel>
                            <ContentControl Style="{StaticResource SettingsRowFirst}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="文件夹名称" Style="{StaticResource TextBody}"/>
                                        <TextBlock Text="仅是显示名称，不会改动磁盘上的文件夹"
                                                   Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox Text="{Binding EditableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,88,0"/>
                                        <Button Content="应用" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Right" Width="80"
                                                Command="{Binding ApplyNameCommand}"/>
                                    </Grid>
                                </Grid>
                            </ContentControl>
                            <ContentControl Style="{StaticResource SettingsRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="文件夹路径" Style="{StaticResource TextBody}"/>
                                        <TextBlock Text="这个文件夹在磁盘上的实际位置"
                                                   Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox Text="{Binding FolderPath, Mode=OneWay}" IsReadOnly="True"
                                                 Margin="0,0,88,0" Background="Transparent"/>
                                        <Button Content="打开" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Right" Width="80"
                                                Command="{Binding OpenFolderCommand}"/>
                                    </Grid>
                                </Grid>
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <!-- ============ 版本列表 ============ -->
                    <TextBlock Text="版本列表" Style="{StaticResource SettingsSectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Versions}" Margin="0,0,0,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameVersion}"
                                                       FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text1Brush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding LoaderText}" Style="{StaticResource TextCaption}"/>
                                                <TextBlock Text="  当前" Style="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="切换" Style="{StaticResource SecondaryButton}"
                                                Width="80" VerticalAlignment="Center"
                                                Command="{Binding DataContext.SwitchVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ============ 移除文件夹（默认文件夹没有这一栏） ============ -->
                    <StackPanel Visibility="{Binding CanRemoveFolder, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="移除文件夹" Style="{StaticResource SettingsSectionTitle}"/>
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <ContentControl Style="{StaticResource SettingsRowFirst}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="移除文件夹" Style="{StaticResource TextBody}"/>
                                            <TextBlock Text="仅从列表中隐藏，文件夹保留在磁盘上"
                                                       Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="移除" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Right" Width="80"
                                                Command="{Binding RemoveFolderCommand}"/>
                                    </Grid>
                                </ContentControl>
                                <ContentControl Style="{StaticResource SettingsRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="删除文件夹" Style="{StaticResource TextBody}"/>
                                            <TextBlock Text="永久清除文件夹及其全部内容，需要两次确认"
                                                       Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="删除" Style="{StaticResource DangerButton}"
                                                HorizontalAlignment="Right" Width="80"
                                                Command="{Binding DeleteFolderCommand}"/>
                                    </Grid>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
