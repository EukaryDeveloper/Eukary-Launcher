<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         设计 Token —— 唯一真源
         改主题 = 改这一组变量。控件里禁止硬编码任何色值/圆角/字号。
         取自《UI 设计图纸》01 节。
         ============================================================ -->

    <!-- 颜色：Color（供动画/SolidColorBrush 取用） -->
    <Color x:Key="BgBaseColor">#121612</Color>
    <Color x:Key="BgSurfaceColor">#1A201A</Color>
    <Color x:Key="BgElevatedColor">#232B23</Color>
    <Color x:Key="BgHoverColor">#2A332A</Color>
    <Color x:Key="BorderColor">#2E382E</Color>
    <Color x:Key="BorderStrongColor">#3D4A3D</Color>

    <Color x:Key="Text1Color">#E9EFE6</Color>
    <Color x:Key="Text2Color">#9BA89B</Color>
    <Color x:Key="Text3Color">#5E6B5E</Color>

    <Color x:Key="AccentColor">#6FCF7A</Color>
    <Color x:Key="AccentHoverColor">#82DA8C</Color>
    <Color x:Key="AccentPressedColor">#5BBE66</Color>
    <Color x:Key="AccentInkColor">#0F2414</Color>
    <Color x:Key="DangerColor">#E57366</Color>
    <Color x:Key="WarningColor">#E5B566</Color>
    <Color x:Key="InfoColor">#6FB8E5</Color>
    <Color x:Key="TooltipBgColor">#0B0E0B</Color>

    <!-- 刷子 -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="{DynamicResource BgBaseColor}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{DynamicResource BgSurfaceColor}"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{DynamicResource BgElevatedColor}"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{DynamicResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="Text1Brush" Color="{DynamicResource Text1Color}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{DynamicResource Text2Color}"/>
    <SolidColorBrush x:Key="Text3Brush" Color="{DynamicResource Text3Color}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="{DynamicResource AccentInkColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}"/>
    <SolidColorBrush x:Key="TooltipBgBrush" Color="{DynamicResource TooltipBgColor}"/>

    <SolidColorBrush x:Key="AccentTintBrush" Color="#6FCF7A" Opacity="0.14"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#E57366" Opacity="0.15"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E57366" Opacity="0.40"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#000000" Opacity="0.55"/>

    <!-- 圆角 -->
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <sys:Double x:Key="RadiusControlValue">8</sys:Double>
    <sys:Double x:Key="RadiusSmValue">6</sys:Double>
    <sys:Double x:Key="RadiusMdValue">10</sys:Double>
    <sys:Double x:Key="RadiusLgValue">14</sys:Double>

    <!-- 字号 -->
    <sys:Double x:Key="FontSizeXs">12</sys:Double>
    <sys:Double x:Key="FontSizeSm">13</sys:Double>
    <sys:Double x:Key="FontSizeBase">14</sys:Double>
    <sys:Double x:Key="FontSizeLg">16</sys:Double>
    <sys:Double x:Key="FontSizeXl">20</sys:Double>

    <!-- 间距（4px 栅格） -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">24</sys:Double>
    <sys:Double x:Key="Space6">32</sys:Double>
    <Thickness x:Key="Space1T">4</Thickness>
    <Thickness x:Key="Space2T">8</Thickness>
    <Thickness x:Key="Space3T">12</Thickness>
    <Thickness x:Key="Space4T">16</Thickness>
    <Thickness x:Key="Space5T">24</Thickness>
    <Thickness x:Key="Space6T">32</Thickness>

    <!-- 控件尺寸 -->
    <sys:Double x:Key="ControlHeightSm">28</sys:Double>
    <sys:Double x:Key="ControlHeightMd">34</sys:Double>
    <sys:Double x:Key="ControlHeightLg">40</sys:Double>
    <sys:Double x:Key="TitleBarHeight">38</sys:Double>
    <sys:Double x:Key="SidebarWidth">180</sys:Double>
    <sys:Double x:Key="ProgressHeight">6</sys:Double>

    <!-- 动效时长（三档） -->
    <Duration x:Key="DurationMicro">0:0:0.12</Duration>
    <Duration x:Key="DurationPage">0:0:0.2</Duration>
    <Duration x:Key="DurationDialog">0:0:0.3</Duration>

    <!-- 字体族 -->
    <FontFamily x:Key="FontSans">Segoe UI, PingFang SC, Microsoft YaHei, Noto Sans CJK SC, Sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, JetBrains Mono, monospace</FontFamily>

</ResourceDictionary>
